{
  "name": "night-sky-explorer",
  "compatibility_date": "2026-11-08",
  "main": "worker/media-range.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/concepts/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
